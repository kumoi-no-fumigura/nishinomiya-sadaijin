 ],
 "poems": [
  {
   "seq": "1",
   "text": "すまの蜑のうら漕舟の跡もなくみぬ人戀〓我やなになる",
   "kana": "",
   "speaker": "〔舊本行書躰〕",
   "page": 56,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "2",
   "text": "笛竹のもとの古音は變るともをのか世〓にはならすもあら南",
   "kana": "",
   "speaker": "",
   "page": 56,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "3",
   "text": "さりともと思ふ心にひかされていまゝて世にもふる我身かな",
   "kana": "",
   "speaker": "",
   "page": 56,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "4",
   "text": "たのむるに命のゝふス物ならは千歳もかくてあらむとや思ふ",
   "kana": "",
   "speaker": "",
   "page": 56,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "5",
   "text": "年月は我身にそへて過ぬれとおもふ心のゆかすも有哉",
   "kana": "",
   "speaker": "",
   "page": 56,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "6",
   "text": "もろともに哀といはすは人しれぬとはす語をわれのみやせん",
   "kana": "",
   "speaker": "",
   "page": 56,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "7",
   "text": "たれしあらは岩根の松と聞しかは心にのみそまかせさりける",
   "kana": "",
   "speaker": "",
   "page": 56,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "8",
   "text": "朽かたき物とこそきけときかへて常盤の松と成にける哉",
   "kana": "",
   "speaker": "",
   "page": 56,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "9",
   "text": "夢にたにみぬものからに暮かたき春の日をのみなかめつる哉",
   "kana": "",
   "speaker": "",
   "page": 56,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "10",
   "text": "常夏にわひしき物は色ふかく思ひそめたる心なりけり",
   "kana": "",
   "speaker": "",
   "page": 56,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "11",
   "text": "五月雨のなかめにぬれて郭公ことしさへにやふる聲をせん",
   "kana": "",
   "speaker": "",
   "page": 56,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "12",
   "text": "現にもあらぬ〓とこそかたからめ夢はかりたにみつといはれむ",
   "kana": "",
   "speaker": "",
   "page": 56,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "13",
   "text": "見つとたにいふへきかたもおもほえす現も夢に我はみえねは",
   "kana": "",
   "speaker": "",
   "page": 56,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "14",
   "text": "露はかり賴む心はなけれとも誰にかゝれる我ならなくに",
   "kana": "",
   "speaker": "",
   "page": 56,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "15",
   "text": "はかりなき草葉をみつゝ白露のかゝる〓とこそあはれ成けれ",
   "kana": "",
   "speaker": "",
   "page": 56,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "16",
   "text": "はかなから草としりせは白露のかゝる〓とをそしらすそあらまし",
   "kana": "",
   "speaker": "",
   "page": 56,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "17",
   "text": "よそにのみあるそ侘しき久かたの天津空にもすまぬものから",
   "kana": "",
   "speaker": "",
   "page": 56,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "18",
   "text": "我ひとり思へはくるし限なき心はかりをわきてしらせん",
   "kana": "",
   "speaker": "",
   "page": 56,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "19",
   "text": "人やりにあらぬものから恨むるも身の〓とはりと思ひしらすや",
   "kana": "",
   "speaker": "",
   "page": 56,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "20",
   "text": "わひはてゝやみもしぬへき〓そにのみ難面人をきくの白露",
   "kana": "",
   "speaker": "",
   "page": 56,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "21",
   "text": "かくしつゝ月日を經ぬる世中に有がたき身を我いかにせん",
   "kana": "",
   "speaker": "",
   "page": 56,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "22",
   "text": "明暮に思ふ心をうつゝにも夢にもみぬはたかつらき也",
   "kana": "",
   "speaker": "",
   "page": 56,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "23",
   "text": "日をこそは長きものとは思ひつれ月のほとたに暮かたき哉",
   "kana": "",
   "speaker": "",
   "page": 56,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "24",
   "text": "またなしとこたふはかりそ今はたゝ誰にもとはて我に問かし",
   "kana": "",
   "speaker": "",
   "page": 56,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "25",
   "text": "限なくもゆる思ひの中にたにみえもせなくにわれいかにせむ",
   "kana": "",
   "speaker": "",
   "page": 56,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "26",
   "text": "世中にときを侍つるかひもなく夢にたにやはみえしらすらん",
   "kana": "",
   "speaker": "",
   "page": 56,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "27",
   "text": "をきところ有ともみえぬ露にのみ思ひけちても長閑成かな",
   "kana": "",
   "speaker": "",
   "page": 56,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "28",
   "text": "人しれぬ我そ侘しき白露のいとゝ心に消んとやする",
   "kana": "",
   "speaker": "",
   "page": 56,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "29",
   "text": "ひかりまつ下にかゝれる露の命消はてねとや春のつれなき",
   "kana": "",
   "speaker": "",
   "page": 56,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "30",
   "text": "鶯の木つたふ花にふみつけし跡の見えぬをいかて尋ん",
   "kana": "",
   "speaker": "",
   "page": 56,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "31",
   "text": "歎つゝ忍ふる〓とのくるしきにいひても物をおもふころ哉",
   "kana": "",
   "speaker": "",
   "page": 56,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "32",
   "text": "山彥のこたふる聲や聞ゆらんなかめしほとに春はきにけり",
   "kana": "",
   "speaker": "",
   "page": 56,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "33",
   "text": "もろともにみん人もかな獨のみをれはかひなき常夏の花",
   "kana": "",
   "speaker": "",
   "page": 56,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "34",
   "text": "限りなく深き心もかくしあらはあさましくやは思ひたえなん",
   "kana": "",
   "speaker": "",
   "page": 56,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "35",
   "text": "いとふてふ〓との葉をたに露はかりみまくほしきや何の心そ",
   "kana": "",
   "speaker": "",
   "page": 56,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "36",
   "text": "水くきのあとをし君にまりすれはゆかぬ心もあらしとそ思ふ",
   "kana": "",
   "speaker": "",
   "page": 56,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "37",
   "text": "あたならむ人の心を水莖のせきとめはてすなかれましやは",
   "kana": "",
   "speaker": "",
   "page": 56,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "38",
   "text": "はつ雁のはつかに聞し〓とつても雲路にたえてわふる頃かな",
   "kana": "",
   "speaker": "",
   "page": 56,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "39",
   "text": "いとふてふ言の葉ならは年をへて秋を何しか色のみつらん",
   "kana": "",
   "speaker": "",
   "page": 56,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "40",
   "text": "神無月時雨とのみや思ふらん天津空にてこふる泪を",
   "kana": "",
   "speaker": "",
   "page": 56,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "41",
   "text": "空にもや人は知らん夜とゝもにあまつ雲ゐを詠くらせは",
   "kana": "",
   "speaker": "",
   "page": 56,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "42",
   "text": "打侘て啼音にかへは山彥のこたへぬ空はあらしとを思ふ",
   "kana": "",
   "speaker": "",
   "page": 56,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "43",
   "text": "秋の田のほのかに人を哀ともいはてにかけてやまんとやする",
   "kana": "",
   "speaker": "",
   "page": 56,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "44",
   "text": "時雨にも雨にもあてしいたつらに年のふるにそ袖はぬれける",
   "kana": "",
   "speaker": "",
   "page": 56,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "45",
   "text": "秋の夜の月の光にあらねともあけてはおとる物にそ有ける",
   "kana": "",
   "speaker": "",
   "page": 56,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "46",
   "text": "年をへてこりぬ思ひの甲斐もなし心みかてら厭ふとおもへは",
   "kana": "",
   "speaker": "",
   "page": 56,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "47",
   "text": "春をたにいつしかとのみ思ひけんまつ鶯の聲もせなくに",
   "kana": "",
   "speaker": "",
   "page": 56,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "48",
   "text": "なかゝらむ心みえにもかくはかり長閑き春の名をたつる哉",
   "kana": "",
   "speaker": "",
   "page": 56,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "49",
   "text": "人しれす君によそへて梅の花おりみる程に袖そ濡ぬる",
   "kana": "",
   "speaker": "",
   "page": 56,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "50",
   "text": "ぬるゝほと露ならなくにから衣はかなき名をも殘すなる哉",
   "kana": "",
   "speaker": "",
   "page": 56,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "51",
   "text": "打忍ひなくとせしかと君こふる涙はいろに出にけるかな",
   "kana": "",
   "speaker": "",
   "page": 56,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "52",
   "text": "皆人のいひふるしてし〓となれとこの五月雨はあやしかりけり",
   "kana": "",
   "speaker": "",
   "page": 56,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "53",
   "text": "いひふるす人たになくは打つけに思はぬともいはすはぁらまし",
   "kana": "",
   "speaker": "西宮左大臣御集",
   "page": 56,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "54",
   "text": "ふりにける〓との厭ひにせきなからいはぬはつらき心ち社すれ",
   "kana": "",
   "speaker": "",
   "page": 56,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "55",
   "text": "ひた道に賴めは人をつらしとも知らぬ顔にてあらんとそ思ふ",
   "kana": "",
   "speaker": "",
   "page": 56,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "56",
   "text": "つらさをは咎めぬ人のひたふるにたえぬといふもいか、賴まむ",
   "kana": "",
   "speaker": "",
   "page": 56,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "57",
   "text": "つらくとも何か恨ん今さらにうれしさ誰か君にまさらむ",
   "kana": "",
   "speaker": "",
   "page": 56,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "58",
   "text": "けふよりは秋のはしめと聞からに袖のたもとそ露けかりける",
   "kana": "",
   "speaker": "",
   "page": 56,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "59",
   "text": "たのまれぬ秋の心にゝる人や露けきほとを先は知らん",
   "kana": "",
   "speaker": "",
   "page": 56,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "60",
   "text": "言の葉の色にさこそは優るらんなとてか秋をたのまさるへき",
   "kana": "",
   "speaker": "",
   "page": 56,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "61",
   "text": "かたるたに深からは社こひ〓とにしらぬ哀をいはんとおもはめ",
   "kana": "",
   "speaker": "",
   "page": 56,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "62",
   "text": "こひとにまたいむしらぬ君ならはふかき心のあらんとそ思ふ",
   "kana": "",
   "speaker": "",
   "page": 56,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "63",
   "text": "たなはたの契れる秋もきにけるはいつとさためめ我そ悲しき",
   "kana": "",
   "speaker": "",
   "page": 56,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "64",
   "text": "うたかひもなき七夕の中なれは契れるほとを過ぬなる哉",
   "kana": "",
   "speaker": "",
   "page": 56,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "65",
   "text": "秋深く成行野へに鳴むしのいとゝ侘たるこゑきこゆ也",
   "kana": "",
   "speaker": "",
   "page": 56,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "66",
   "text": "思ふ事有てなかれと秋きつと〓とになきける虫の聲きけ",
   "kana": "",
   "speaker": "",
   "page": 56,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "67",
   "text": "時雨する神無月かと聞しかと涙の玉そけふふりにける",
   "kana": "",
   "speaker": "",
   "page": 56,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "68",
   "text": "涙ともわかれぬ雨のふりけるは時雨ときかは哀ならまし",
   "kana": "",
   "speaker": "",
   "page": 56,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "69",
   "text": "よとゝもにたえめ泪の雨よりは時雨や何そなにならなくに",
   "kana": "",
   "speaker": "金槐和歌集",
   "page": 57,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "70",
   "text": "空に降泪のよにし聞ゆれは袖の時雨をおとりこそせね",
   "kana": "",
   "speaker": "",
   "page": 57,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "71",
   "text": "なく涙空にもなとかふらさらんあま雲晴ぬ物を思へは",
   "kana": "",
   "speaker": "",
   "page": 57,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "72",
   "text": "いかてへし我ならなくに〓としあらは今しも物の悲しかる蘭",
   "kana": "",
   "speaker": "",
   "page": 57,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "73",
   "text": "有しより今しもとのみ悲しきはさてそ中〓〓あるへかりける",
   "kana": "",
   "speaker": "",
   "page": 57,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "74",
   "text": "篝火もものもしる〓〓あかすのみまとふ心をおもひしぁらん",
   "kana": "",
   "speaker": "",
   "page": 57,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "75",
   "text": "袖の色のこく成ぬれは我戀をしらせそめつる涙なりけり",
   "kana": "",
   "speaker": "",
   "page": 57,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "76",
   "text": "山彥のこたへぬ空はよにもあらし聲をさへにも隔つる哉",
   "kana": "",
   "speaker": "",
   "page": 57,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "77",
   "text": "詠めあかでおかしきとをいひしまに戀も我身もつみてける哉",
   "kana": "",
   "speaker": "",
   "page": 57,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  }
 ],
